{
  "entities": {
    "artistAccount": {
      "title": "Artist Account",
      "description": "Artist profile registered on open music platform and synced to Firebase",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 1000 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "genre": { "type": "string", "maxLength": 50 },
        "audiusHandle": { "type": "string", "maxLength": 100 },
        "accountUrl": { "type": "string", "maxLength": 500 },
        "providerPlatform": { "type": "string", "maxLength": 100 },
        "googleUid": { "type": "string", "maxLength": 128 },
        "googleEmail": { "type": "string", "maxLength": 200 },
        "hasAcceptedTerms": { "type": "boolean" },
        "acceptedTermsAt": { "type": "string", "maxLength": 50 },
        "isPrivate": { "type": "boolean" },
        "tracksCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    },
    "artistTrack": {
      "title": "Artist Track",
      "description": "Music track uploaded by artist and stored in Firebase Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "artistName": { "type": "string", "maxLength": 100 },
        "albumName": { "type": "string", "maxLength": 100 },
        "duration": { "type": "number" },
        "audioUrl": { "type": "string", "maxLength": 1000 },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "genre": { "type": "string", "maxLength": 50 },
        "license": { "type": "string", "maxLength": 200 },
        "source": { "type": "string", "maxLength": 200 },
        "legalStatus": { "type": "string", "maxLength": 200 },
        "lyrics": { "type": "string", "maxLength": 5000 },
        "publishedDate": { "type": "string", "maxLength": 50 },
        "artistBio": { "type": "string", "maxLength": 1000 },
        "artistAvatarUrl": { "type": "string", "maxLength": 500 },
        "publisherAccountUrl": { "type": "string", "maxLength": 500 },
        "uploadedByUid": { "type": "string", "maxLength": 128 },
        "isPrivate": { "type": "boolean" },
        "customServerUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "artistName", "audioUrl"]
    }
  },
  "firestore": {
    "/artistAccounts/{artistId}": {
      "schema": "artistAccount",
      "description": "Collection of open network registered artists and user profiles"
    },
    "/artistTracks/{trackId}": {
      "schema": "artistTrack",
      "description": "Collection of user-submitted tracks cleared for open streaming and server persistence"
    }
  }
}
