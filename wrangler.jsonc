{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kolot-music",
  "main": "./worker.ts",
  "compatibility_date": "2025-04-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/ilms.txt",
      "/api/*",
      "/auth/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "kolot-music"
    }
  ]
}
