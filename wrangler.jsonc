{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kolot-music",
  "main": "./worker.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "kolot-music"
    }
  ]
}
